{
  "name": "alluvium",
  "version": "0.1.0",
  "description": "Auto-archive Claude Code sessions to your Obsidian vault as a Karpathy-style LLM wiki.",
  "author": {
    "name": "Eric"
  },
  "homepage": "https://github.com/Tespera/alluvium",
  "repository": "https://github.com/Tespera/alluvium",
  "license": "MIT OR Apache-2.0",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "alluvium session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "alluvium pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "alluvium archive --detached"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "alluvium session-end"
          }
        ]
      }
    ]
  }
}
